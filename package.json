{
  "name": "@ds-hu/dsh-pocket",
  "description": "把 DeepSeek Harness 装进你的口袋：单端口 3081 + Gitee / GitHub OAuth 登录（初始化时二选一），自建隧道（固定域名）即可远程实时同屏访问电脑上的 DSH。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "bin": {
    "dsh-pocket": "bin/dsh-pocket.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./icon": "./icon.svg",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "client",
    "mobile",
    "scripts",
    "assets",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:client": "node client/build.mjs",
    "build:pwa-icons": "node scripts/build-pwa-icons.mjs",
    "postinstall": "node scripts/link-mobile-package.mjs",
    "pretest": "npm run build:client",
    "release": "semantic-release",
    "test": "node --test --test-timeout=30000 \"test/*.test.js\""
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "esbuild": "^0.25.9",
    "semantic-release": "^24.2.9",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "dsh-pocket-mobile": "file:./mobile"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "GPL-2.0",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-pocket",
    "cordis",
    "mobile",
    "remote-access",
    "oauth2",
    "gitee",
    "github",
    "qr-code"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-session-log-export"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cup113/dsh-pocket-oauth.git"
  },
  "bugs": {
    "url": "https://github.com/cup113/dsh-pocket-oauth/issues"
  },
  "homepage": "https://github.com/cup113/dsh-pocket-oauth",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "version": "2.10.6"
}
